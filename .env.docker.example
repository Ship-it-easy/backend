# Database (PostgreSQL) 
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASS=postgres_secret

# Application Settings
BACKEND_PORT=8000
SESSION_EXPIRATION_MINUTES=60

# Local planning geo services
VALHALLA_URL=http://valhalla:8002
# Built-in local MosMetro adapter. It proxies only schema and route requests.
MOSMETRO_URL=http://mosmetro:8083
MOSMETRO_API_URL=https://prodapp.mosmetro.ru/api
ROUTER_API_URL=https://mosmetro.ru/router/api/routes
MOSMETRO_REQUEST_TIMEOUT_SECONDS=20
MOSMETRO_SCHEMA_CACHE_SECONDS=3600
MOSMETRO_MAX_ACCESS_METERS=2500
MOSMETRO_WAITING_SECONDS=180
NOMINATIM_URL=http://nominatim:8080
NOMINATIM_VIEWBOX=35.0,57.0,40.5,54.0
# Keep false for Nominatim; set true to use Yandex for all geocoding.
USE_YANDEX_GEOCODER=false
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru
# Optional Yandex bbox as "lower-left~upper-right"; falls back to NOMINATIM_VIEWBOX.
YANDEX_GEOCODER_BBOX=
GEOSERVICE_TIMEOUT_SEC=15
MATRIX_BLOCK_SIZE=40
OSM_PBF_URL=https://download.openstreetmap.fr/extracts/russia/central_federal_district-latest.osm.pbf
VALHALLA_THREADS=2
NOMINATIM_PASSWORD=nominatim
NOMINATIM_THREADS=2

# Local HTTP demo only; set true behind HTTPS.
SESSION_COOKIE_SECURE=false
MATRIX_CANDIDATE_LIMIT=0
