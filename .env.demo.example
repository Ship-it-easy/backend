# Copy to .env.demo. Replace the domain, email and both passwords.
DEMO_DOMAIN=demo.example.ru
ACME_EMAIL=you@example.ru

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASS=REPLACE_WITH_RANDOM_PASSWORD

BACKEND_PORT=8000
SESSION_EXPIRATION_MINUTES=60
SESSION_COOKIE_SECURE=true

VALHALLA_URL=http://valhalla:8002
NOMINATIM_URL=http://nominatim:8080
NOMINATIM_VIEWBOX=35.0,57.0,40.5,54.0
OSM_PBF_URL=https://download.openstreetmap.fr/extracts/russia/central_federal_district/moscow-latest.osm.pbf
VALHALLA_THREADS=1
NOMINATIM_THREADS=1
NOMINATIM_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD

USE_YANDEX_GEOCODER=false
YANDEX_GEOCODER_API_KEY=
GEOSERVICE_TIMEOUT_SEC=15
MATRIX_BLOCK_SIZE=40
MATRIX_CANDIDATE_LIMIT=0
TRAFFIC_MODEL_ENABLED=true
