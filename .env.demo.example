# Copy to .env.demo. Replace the database password and Yandex key.
# Private NAT address of this VPS; change if the provider changes it.
DEMO_HTTP_BIND=192.168.8.29
DEMO_HTTP_PORT=8080


POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASS=REPLACE_WITH_RANDOM_PASSWORD

BACKEND_PORT=8000
SESSION_EXPIRATION_MINUTES=60
SESSION_COOKIE_SECURE=true

VALHALLA_URL=http://valhalla:8002
# The backend uses this box as the Yandex Geocoder search area too.
NOMINATIM_VIEWBOX=35.0,57.0,40.5,54.0
OSM_PBF_URL=https://download.openstreetmap.fr/extracts/russia/central_federal_district/moscow-latest.osm.pbf
VALHALLA_THREADS=1

USE_YANDEX_GEOCODER=true
YANDEX_GEOCODER_API_KEY=REPLACE_WITH_YANDEX_GEOCODER_KEY
YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru
YANDEX_GEOCODER_BBOX=
GEOSERVICE_TIMEOUT_SEC=15
MATRIX_BLOCK_SIZE=40
MATRIX_CANDIDATE_LIMIT=0
TRAFFIC_MODEL_ENABLED=true
