# Database (PostgreSQL)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASS=

# Application Settings
BACKEND_PORT=
SESSION_EXPIRATION_MINUTES=

# Local planning geo services
VALHALLA_URL=http://localhost:8002
NOMINATIM_URL=http://localhost:8080
NOMINATIM_VIEWBOX=35.0,57.0,40.5,54.0
# Keep false for Nominatim; set true to use Yandex for all geocoding.
USE_YANDEX_GEOCODER=false
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru
# Optional Yandex bbox as "lower-left~upper-right"; falls back to NOMINATIM_VIEWBOX.
YANDEX_GEOCODER_BBOX=
GEOSERVICE_TIMEOUT_SEC=15
MATRIX_BLOCK_SIZE=40
OSM_PBF_URL=https://download.openstreetmap.fr/extracts/russia/central_federal_district-latest.osm.pbf
VALHALLA_THREADS=2
NOMINATIM_PASSWORD=nominatim
NOMINATIM_THREADS=2

# Local HTTP demo only; set true behind HTTPS.
SESSION_COOKIE_SECURE=false
